// Deploys the app jar from an existing PetsPipeline build to the chosen environment.
// Start it from Jenkins: PetsPromote -> Build with Parameters.

// SSH credential and port of each Vagrant box (see: vagrant ssh-config <box>)
def SERVERS = [
	dev : [credentialsId: 'vagrant-dev',  port: '2250'],
	test: [credentialsId: 'vagrant-test', port: '2249'],
	uat : [credentialsId: 'vagrant-uat',  port: '2248'],
]

pipeline {
	agent any

	parameters {
		string(name: 'SOURCE_BRANCH', defaultValue: 'main', description: 'Branch or PR in PetsPipeline that built the jar, e.g. main or PR-5')
		string(name: 'SOURCE_BUILD', description: 'Build number of that branch, e.g. 12')
		choice(name: 'ENV', choices: ['test', 'uat', 'dev'], description: 'Where to deploy')
	}

	stages {
		stage("Get artifact") {
			steps {
				// Shown in the build history, e.g. "PR-5 #12 -> uat"
				script {
					currentBuild.description = "${params.SOURCE_BRANCH} #${params.SOURCE_BUILD} -> ${params.ENV}"
				}
				// Remove jars left from previous promotions
				deleteDir()
				copyArtifacts(
					projectName: "PetsPipeline/${params.SOURCE_BRANCH}",
					selector: specific(params.SOURCE_BUILD),
					filter: 'target/app-*.jar'
				)
			}
		}

		stage("Deploy") {
			environment {
				DEPLOY_HOST = 'host.docker.internal'
				DEPLOY_PORT = "${SERVERS[params.ENV].port}"
				SSH_OPTS = '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
			}
			steps {
				withCredentials([
					sshUserPrivateKey(
						credentialsId: SERVERS[params.ENV].credentialsId,
						keyFileVariable: 'SSH_KEY',
						usernameVariable: 'SSH_USER'
					)
				]) {
					// 1. Stop the running app ("|| true" so it doesn't fail when nothing is running yet)
					sh 'ssh $SSH_OPTS -i $SSH_KEY -p $DEPLOY_PORT $SSH_USER@$DEPLOY_HOST "pkill java || true"'

					// 2. Upload the jar ("-b -" makes sftp fail the build if the upload fails)
					sh 'echo "put target/app-*.jar app.jar" | sftp $SSH_OPTS -i $SSH_KEY -P $DEPLOY_PORT -b - $SSH_USER@$DEPLOY_HOST'

					// 3. Start the app in the background, logs go to app.log
					sh 'ssh $SSH_OPTS -i $SSH_KEY -p $DEPLOY_PORT $SSH_USER@$DEPLOY_HOST "nohup java -jar app.jar > app.log 2>&1 &"'
				}
			}
		}
	}
}
